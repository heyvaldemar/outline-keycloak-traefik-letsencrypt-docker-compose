# Outline + Keycloak + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before deploying the three
# compose files. `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in each compose file's `x-images` block, so `git pull`
# delivers the version combination this repository has tested. To pin a
# different version yourself, uncomment and set:
# TRAEFIK_IMAGE_TAG=traefik:3.7@sha256:…
# KEYCLOAK_POSTGRES_IMAGE_TAG=postgres:16@sha256:…
# KEYCLOAK_IMAGE_TAG=quay.io/keycloak/keycloak:26.7.3@sha256:…
# OUTLINE_POSTGRES_IMAGE_TAG=postgres:16@sha256:…
# OUTLINE_IMAGE_TAG=outlinewiki/outline:1.9.2@sha256:…
# OUTLINE_REDIS_IMAGE_TAG=redis:7.4@sha256:…
# OUTLINE_MINIO_IMAGE_TAG=minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.outline.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Keycloak (identity provider for Outline)
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname for Keycloak. REQUIRED.
KEYCLOAK_HOSTNAME=keycloak.outline.example.com

# REQUIRED — generate each with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
KEYCLOAK_DB_PASSWORD=change_me_before_first_start
KEYCLOAK_ADMIN_PASSWORD=change_me_before_first_start

# Defaults: KEYCLOAK_DB_NAME=keycloakdb, KEYCLOAK_DB_USER=keycloakdbuser,
# KEYCLOAK_ADMIN_USERNAME=keycloakadmin.

# ──────────────────────────────────────────────────────────────────────────────
# Outline
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname and full URL for Outline. REQUIRED.
OUTLINE_HOSTNAME=outline.example.com
OUTLINE_URL=https://outline.example.com

# REQUIRED — generate each with: openssl rand -hex 32
OUTLINE_SECRET_KEY=change_me_openssl_rand_hex_32
OUTLINE_UTILS_SECRET=change_me_openssl_rand_hex_32

# REQUIRED — generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 32
OUTLINE_DB_PASSWORD=change_me_before_first_start

# OIDC client secret from the Keycloak client you create for Outline
# (realm `outline`, client `outline`) — see the README walkthrough. REQUIRED.
OUTLINE_OIDC_CLIENT_SECRET=change_me_from_keycloak_client

# OIDC endpoints — replace the hostname with your KEYCLOAK_HOSTNAME. REQUIRED.
OUTLINE_OIDC_AUTH_URI=https://keycloak.outline.example.com/realms/outline/protocol/openid-connect/auth
OUTLINE_OIDC_TOKEN_URI=https://keycloak.outline.example.com/realms/outline/protocol/openid-connect/token
OUTLINE_OIDC_USERINFO_URI=https://keycloak.outline.example.com/realms/outline/protocol/openid-connect/userinfo

# ──────────────────────────────────────────────────────────────────────────────
# Garage (file storage for Outline)
# ──────────────────────────────────────────────────────────────────────────────
#
# This was MinIO until v2.0.0. MinIO's community server was archived on
# 25 April 2026 — read-only repository, no further releases, and the last
# published image is RELEASE.2025-09-07. If you are upgrading rather than
# deploying fresh, read the migration section of the README BEFORE `up -d`:
# your existing attachments are in the old volume and do not move by
# themselves.

# Public hostname for the S3 endpoint. REQUIRED.
#
# There is no second hostname any more. Garage has no web console, which is a
# real loss of convenience — `mc` or any S3 client is how you look inside a
# bucket now — and the reason it is accepted is in the paragraph above.
OUTLINE_S3_HOSTNAME=s3.outline.example.com

# The credentials Outline signs its requests with, imported into Garage by the
# init container on first start. REQUIRED — generate with:
#     echo "OUTLINE_S3_ACCESS_KEY=GK$(openssl rand -hex 12)"
#     echo "OUTLINE_S3_SECRET_KEY=$(openssl rand -hex 32)"
#
# The GK prefix is Garage's convention rather than a requirement, and a
# 64-character hex secret is what its own `key create` produces. Keeping to
# both means nothing here looks unusual to anyone reading Garage's own
# documentation later.
OUTLINE_S3_ACCESS_KEY=change_me_before_first_start
OUTLINE_S3_SECRET_KEY=change_me_before_first_start

# Garage's own secrets, read from the environment rather than written into
# garage/garage.toml so that every secret lives in this one file. REQUIRED —
# generate each with:
#     openssl rand -hex 32
#
# The RPC secret authenticates nodes to each other. There is one node here, so
# it never leaves the container — but Garage refuses to start without it, and
# a placeholder shared by every deployment of this template would be a worse
# answer than a generated one.
OUTLINE_GARAGE_RPC_SECRET=change_me_before_first_start
OUTLINE_GARAGE_ADMIN_TOKEN=change_me_before_first_start

# Defaults: OUTLINE_S3_BUCKET_NAME=data, OUTLINE_S3_KEY_NAME=outline,
# OUTLINE_GARAGE_ZONE=default, OUTLINE_GARAGE_CAPACITY=100000000000 (100 GB).
#
# The capacity figure is how Garage weights a node when it distributes data.
# On a single node nothing is distributed, so it changes nothing except what
# `garage status` reports — set it to roughly the disk you are willing to give
# this if you want that number to mean something.

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# KEYCLOAK_BACKUP_INIT_SLEEP=30m / KEYCLOAK_BACKUP_INTERVAL=24h
# KEYCLOAK_POSTGRES_BACKUP_PRUNE_DAYS=7
# OUTLINE_BACKUP_INIT_SLEEP=30m / OUTLINE_BACKUP_INTERVAL=24h
# OUTLINE_POSTGRES_BACKUP_PRUNE_DAYS=7 / OUTLINE_DATA_BACKUP_PRUNE_DAYS=7

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# OUTLINE_KEYCLOAK_POSTGRES_KEYCLOAK_MEMORY_LIMIT=1g
# OUTLINE_KEYCLOAK_POSTGRES_KEYCLOAK_CPU_LIMIT=1.0
# OUTLINE_KEYCLOAK_POSTGRES_KEYCLOAK_MEMORY_RESERVATION=128m
# OUTLINE_KEYCLOAK_POSTGRES_KEYCLOAK_CPU_RESERVATION=0.25
# OUTLINE_KEYCLOAK_KEYCLOAK_MEMORY_LIMIT=1g
# OUTLINE_KEYCLOAK_KEYCLOAK_CPU_LIMIT=1.0
# OUTLINE_KEYCLOAK_KEYCLOAK_MEMORY_RESERVATION=128m
# OUTLINE_KEYCLOAK_KEYCLOAK_CPU_RESERVATION=0.25
# OUTLINE_KEYCLOAK_BACKUPS_KEYCLOAK_MEMORY_LIMIT=256m
# OUTLINE_KEYCLOAK_BACKUPS_KEYCLOAK_CPU_LIMIT=0.5
# OUTLINE_KEYCLOAK_BACKUPS_KEYCLOAK_MEMORY_RESERVATION=32m
# OUTLINE_KEYCLOAK_BACKUPS_KEYCLOAK_CPU_RESERVATION=0.1
# OUTLINE_KEYCLOAK_POSTGRES_OUTLINE_MEMORY_LIMIT=1g
# OUTLINE_KEYCLOAK_POSTGRES_OUTLINE_CPU_LIMIT=1.0
# OUTLINE_KEYCLOAK_POSTGRES_OUTLINE_MEMORY_RESERVATION=128m
# OUTLINE_KEYCLOAK_POSTGRES_OUTLINE_CPU_RESERVATION=0.25
# OUTLINE_KEYCLOAK_REDIS_MEMORY_LIMIT=256m
# OUTLINE_KEYCLOAK_REDIS_CPU_LIMIT=0.5
# OUTLINE_KEYCLOAK_REDIS_MEMORY_RESERVATION=32m
# OUTLINE_KEYCLOAK_REDIS_CPU_RESERVATION=0.1
# OUTLINE_KEYCLOAK_MINIO_MEMORY_LIMIT=1g
# OUTLINE_KEYCLOAK_MINIO_CPU_LIMIT=1.0
# OUTLINE_KEYCLOAK_MINIO_MEMORY_RESERVATION=128m
# OUTLINE_KEYCLOAK_MINIO_CPU_RESERVATION=0.25
# OUTLINE_KEYCLOAK_OUTLINE_MEMORY_LIMIT=1g
# OUTLINE_KEYCLOAK_OUTLINE_CPU_LIMIT=1.0
# OUTLINE_KEYCLOAK_OUTLINE_MEMORY_RESERVATION=128m
# OUTLINE_KEYCLOAK_OUTLINE_CPU_RESERVATION=0.25
# OUTLINE_KEYCLOAK_BACKUPS_OUTLINE_MEMORY_LIMIT=256m
# OUTLINE_KEYCLOAK_BACKUPS_OUTLINE_CPU_LIMIT=0.5
# OUTLINE_KEYCLOAK_BACKUPS_OUTLINE_MEMORY_RESERVATION=32m
# OUTLINE_KEYCLOAK_BACKUPS_OUTLINE_CPU_RESERVATION=0.1

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# KEYCLOAK_POSTGRES_IMAGE_VERSION=16
# KEYCLOAK_IMAGE_VERSION=26.7.3
# OUTLINE_POSTGRES_IMAGE_VERSION=16
# OUTLINE_IMAGE_VERSION=1.9.2
# OUTLINE_REDIS_IMAGE_VERSION=7.4
# OUTLINE_MINIO_IMAGE_VERSION=RELEASE.2025-09-07T16-13-09Z
